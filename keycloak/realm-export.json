{
  "realm": "mcp-demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "crm-user", "description": "Can use the CRM application and its MCP tools" },
      { "name": "orders-user", "description": "Can use the Orders application and its MCP tools" }
    ]
  },
  "clients": [
    {
      "clientId": "frontend-web",
      "name": "Demo Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:3001"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    },
    {
      "clientId": "mcp-gateway",
      "name": "MCP Gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "mcp-secret-123",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      }
    }
  ],
  "users": [
    {
      "username": "mario.sales",
      "enabled": true,
      "emailVerified": true,
      "email": "mario.sales@example.com",
      "firstName": "Mario",
      "lastName": "Sales",
      "credentials": [{ "type": "password", "value": "test", "temporary": false }],
      "realmRoles": ["crm-user"]
    },
    {
      "username": "luigi.finance",
      "enabled": true,
      "emailVerified": true,
      "email": "luigi.finance@example.com",
      "firstName": "Luigi",
      "lastName": "Finance",
      "credentials": [{ "type": "password", "value": "test", "temporary": false }],
      "realmRoles": ["orders-user"]
    }
  ]
}
